{
  "name": "protect-develop-v1",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/heads/develop"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "require_extra_approval_for_unattributed_changes": false,
        "required_review_thread_resolution": true,
        "allowed_merge_methods": [
          "merge",
          "squash",
          "rebase"
        ]
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "Guard and migration immutability",
            "integration_id": 15368
          },
          {
            "context": "Maven verification and tested artifact",
            "integration_id": 15368
          },
          {
            "context": "Flyway empty database gate",
            "integration_id": 15368
          },
          {
            "context": "Flyway existing database gate",
            "integration_id": 15368
          },
          {
            "context": "Docker runtime and migration gate",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
