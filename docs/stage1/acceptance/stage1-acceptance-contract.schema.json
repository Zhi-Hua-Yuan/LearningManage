{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1-acceptance-contract.schema.json",
  "title": "LearningManage Stage 1 Acceptance Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stage",
    "contractVersion",
    "status",
    "baseline",
    "designInputs",
    "gates"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "stage": { "const": "stage1" },
    "contractVersion": { "type": "integer", "minimum": 1 },
    "status": { "enum": ["DRAFT", "FROZEN", "PASS", "FAIL"] },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flywayPublishedVersion",
        "frontendExistingOperationCount",
        "frontendExistingMissingOperationCount",
        "backendExpectedTestCountAtDesignTime"
      ],
      "properties": {
        "flywayPublishedVersion": { "const": "1" },
        "frontendExistingOperationCount": { "const": 37 },
        "frontendExistingMissingOperationCount": { "const": 0 },
        "backendExpectedTestCountAtDesignTime": { "type": "integer", "minimum": 1 }
      }
    },
    "designInputs": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "gates": {
      "type": "array",
      "minItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "requirement", "status", "targetPr", "evidenceRequired"],
        "properties": {
          "id": { "type": "string", "pattern": "^S1-A-[0-9]{3}$" },
          "domain": { "type": "string", "minLength": 1 },
          "requirement": { "type": "string", "minLength": 1 },
          "status": { "enum": ["PENDING", "PASS", "FAIL", "ACCEPTED_RISK", "NOT_APPLICABLE"] },
          "targetPr": { "type": "string", "pattern": "^PR[2-8]$" },
          "evidenceRequired": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
