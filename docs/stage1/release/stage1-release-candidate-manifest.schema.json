{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "stage1-release-candidate-manifest.schema.json",
  "title": "LearningManage Stage 1 Release Candidate Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "stage", "candidateId", "status", "backend", "frontend",
    "flyway", "apiContract", "regression", "stage1Acceptance", "riskClosure",
    "evidence", "workflow"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "stage": {"const": "stage1"},
    "candidateId": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"},
    "status": {"enum":["CANDIDATE_PASS","PASS"]},
    "backend": {"$ref":"#/$defs/repository"},
    "frontend": {"$ref":"#/$defs/repository"},
    "flyway": {
      "type":"object","additionalProperties":false,
      "required":["publishedManifestSha256","v1Sha256","v2Sha256","historyTotal","emptyDatabase","existingDatabase"],
      "properties": {
        "publishedManifestSha256":{"$ref":"#/$defs/sha256"},
        "v1Sha256":{"$ref":"#/$defs/sha256"},
        "v2Sha256":{"$ref":"#/$defs/sha256"},
        "historyTotal":{"type":"integer","const":2},
        "emptyDatabase":{"const":"PASS"},
        "existingDatabase":{"const":"PASS"}
      }
    },
    "apiContract": {
      "type":"object","additionalProperties":false,
      "required":["legacyOperationCount","legacyMissingFromCurrentCount","legacyMissingFromRuntimeCount","frontendOperationCount","runtimeOperationCount","matchedOperationCount","missingOperationCount","comparisonSha256"],
      "properties": {
        "legacyOperationCount":{"type":"integer","const":37},
        "legacyMissingFromCurrentCount":{"type":"integer","const":0},
        "legacyMissingFromRuntimeCount":{"type":"integer","const":0},
        "frontendOperationCount":{"type":"integer","const":44},
        "runtimeOperationCount":{"type":"integer","minimum":1},
        "matchedOperationCount":{"type":"integer","const":44},
        "missingOperationCount":{"type":"integer","const":0},
        "comparisonSha256":{"$ref":"#/$defs/sha256"}
      }
    },
    "regression": {
      "type":"object","additionalProperties":false,
      "required":["backendTests","frontendTests","personalFlow","stage1Flow","aiBreakdownFlow","status"],
      "properties": {
        "backendTests":{"type":"integer","minimum":1},
        "frontendTests":{"type":"integer","minimum":1},
        "personalFlow":{"const":"PASS"},
        "stage1Flow":{"const":"PASS"},
        "aiBreakdownFlow":{"const":"PASS"},
        "status":{"const":"PASS"}
      }
    },
    "stage1Acceptance": {
      "type":"object","additionalProperties":false,
      "required":["contractSha256","schemaSha256","sourceEvidenceIndexSha256","gatesPassed"],
      "properties": {
        "contractSha256":{"$ref":"#/$defs/sha256"},
        "schemaSha256":{"$ref":"#/$defs/sha256"},
        "sourceEvidenceIndexSha256":{"$ref":"#/$defs/sha256"},
        "gatesPassed":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^S1-A-[0-9]{3}$"},"minItems":11,"maxItems":12}
      }
    },
    "riskClosure": {
      "type":"object","additionalProperties":false,
      "required":["s1R010","openBlockingRiskCount"],
      "properties":{"s1R010":{"enum":["ELIGIBLE","CLOSED"]},"openBlockingRiskCount":{"type":"integer","minimum":0,"maximum":1}}
    },
    "evidence": {
      "type":"object","additionalProperties":false,
      "required":["files"],
      "properties":{"files":{"type":"array","minItems":1,"items":{"type":"string"}}}
    },
    "workflow": {
      "type":"object","additionalProperties":false,
      "required":["runId","runAttempt","workflowSha","triggeredBy","executedAt"],
      "properties":{"runId":{"type":"string","pattern":"^[1-9][0-9]*$"},"runAttempt":{"type":"string","pattern":"^[1-9][0-9]*$"},"workflowSha":{"$ref":"#/$defs/sha"},"triggeredBy":{"type":"string","minLength":1},"executedAt":{"type":"string","format":"date-time"}}
    }
  },
  "$defs": {
    "sha": {"type":"string","pattern":"^[0-9a-f]{40}$"},
    "sha256": {"type":"string","pattern":"^[0-9A-F]{64}$"},
    "repository": {
      "type":"object","additionalProperties":false,
      "required":["repository","sha","developShaAtStart","developShaAtEnd"],
      "properties":{"repository":{"type":"string","minLength":1},"sha":{"$ref":"#/$defs/sha"},"developShaAtStart":{"$ref":"#/$defs/sha"},"developShaAtEnd":{"$ref":"#/$defs/sha"}}
    }
  }
}
