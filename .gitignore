# =========================================================================
# 1. 编译产物与构建工具 (Maven)
# =========================================================================
target/
*.jar
*.war
*.ear
# 忽略 Maven 运行时产生的临时文件
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# =========================================================================
# 2. IDE 开发工具配置 (重点是 IntelliJ IDEA)
# =========================================================================
.idea/
*.iml
*.iws
*.ipr
out/
# 如果你偶尔使用 VS Code
.vscode/
.history/

# =========================================================================
# 3. 日志与临时文件
# =========================================================================
logs/
*.log
temp/
.agents/
AGENTS.md

# =========================================================================
# 4. 操作系统相关
# =========================================================================
.DS_Store
Thumbs.db

# =========================================================================
# 5. 敏感配置文件 (核心建议)
# 建议忽略包含敏感信息的配置文件，或者只上传 .example 模板
.env
.env.local
.env.*.local
application-local.yml
application-*.local.yml
!.env.example
# 如果你在本地测试中有敏感配置，也可以忽略 dev 版本
# application-dev.yml

# Docker 数据卷 (极其重要，绝对不能把数据库文件推上去)
deploy/mysql-data/

# 前端构建产物 (如果你把 dist 放进来了，建议忽略它，只传前端源码)
deploy/dist/
/.codex-tmp/

# Stage 3 evaluation working files and expiring raw results
evals/stage3/node_modules/
evals/stage3/.promptfoo/
evals/stage3/output*.json
evals/stage3/summary.json
evals/stage3/report.md
evals/stage3/human-review-sample.json
evals/stage3/human-review-result.json
evals/stage3/tests/generated.json

# Python bytecode/cache generated by CI helper validation
__pycache__/
*.py[cod]
