# Copy to .env.local and replace placeholders. Never commit real credentials.
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=3306
DB_NAME=learning_manage
DB_USERNAME=learning_manage_app
DB_PASSWORD=replace_with_local_database_password
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=2000
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password

# Flyway is disabled by default. The migrator account is separate from the
# business account and must only be supplied in a protected migration session.
FLYWAY_ENABLED=false
FLYWAY_DB_USERNAME=learning_manage_migrator
FLYWAY_DB_PASSWORD=replace_with_migrator_password
FLYWAY_EXPECTED_DB_NAME=learning_manage
FLYWAY_BASELINE_VERSION=1
FLYWAY_BASELINE_AUTHORIZED=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_USERNAME=learning_app
REDIS_PASSWORD=replace_with_redis_acl_password

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRE_SECONDS=86400

ALIYUN_API_KEY=replace_with_your_api_key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_CHAT_ENABLED=true
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=60000
AI_TOTAL_TIMEOUT_MS=120000
AI_MAX_CONCURRENT_CALLS=20
AI_MAX_WAIT_MILLIS=0
AI_PRICE_VERSION=
AI_PRICE_CURRENCY=CNY
QWEN_PLUS_INPUT_PRICE=
QWEN_PLUS_OUTPUT_PRICE=

# Model prices are deliberately not committed because supplier prices change.
# Empty prices keep estimated_cost NULL. Both values and AI_PRICE_VERSION must
# be configured together in protected deployment configuration.

AI_KNOWLEDGE_WORKER_ENABLED=false
AI_KNOWLEDGE_POLL_MS=2000
AI_KNOWLEDGE_CLAIM_BATCH_SIZE=20
AI_KNOWLEDGE_WORKER_CONCURRENCY=4
AI_KNOWLEDGE_LEASE_SECONDS=60
AI_KNOWLEDGE_MAX_ATTEMPTS=5
AI_KNOWLEDGE_EMBEDDING_CONCURRENCY=4
AI_KNOWLEDGE_VECTOR_CONCURRENCY=8
AI_KNOWLEDGE_CB_WINDOW_SIZE=20
AI_KNOWLEDGE_CB_MINIMUM_CALLS=10
AI_KNOWLEDGE_CB_FAILURE_RATE=50
AI_KNOWLEDGE_CB_OPEN_WAIT_MS=30000

AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_QUERY_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSION=1024
AI_EMBEDDING_BATCH_SIZE=10

# Permission-aware RAG remains disabled until V5 is migrated and the initial
# knowledge backfill and permission tests have passed.
AI_RAG_ENABLED=false
AI_RAG_QUESTION_HMAC_SECRET=replace_with_a_separate_32_character_random_secret
AI_RAG_CONFIG_VERSION=rag-v1
AI_RAG_INITIAL_TOP_K=20
AI_RAG_FINAL_TOP_K=8
AI_RAG_VECTOR_SCORE_THRESHOLD=0.25
AI_RAG_RERANK_SCORE_THRESHOLD=0.20
AI_RAG_RESULT_RETENTION_DAYS=30

# Agent is deployed dark. Enable the feature first, then its durable worker;
# enable Tool Calling only after the protected provider contract passes.
AI_AGENT_ENABLED=false
AI_AGENT_WORKER_ENABLED=false
AI_AGENT_TOOL_CALLING_ENABLED=false
AI_AGENT_POLL_DELAY_MS=1000
AI_AGENT_BATCH_SIZE=5
AI_AGENT_MAX_CONCURRENT_RUNS=4
AI_AGENT_MAX_CONCURRENT_RUNS_PER_USER=2
AI_AGENT_LEASE_SECONDS=90
AI_AGENT_HEARTBEAT_SECONDS=15
AI_AGENT_OVERALL_TIMEOUT_SECONDS=60
AI_AGENT_TOOL_TIMEOUT_SECONDS=10
AI_AGENT_MAX_TOOL_CALLS=4
AI_AGENT_MAX_ATTEMPTS=2

AI_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
AI_RERANK_API_KEY=
AI_RERANK_MODEL=qwen3-rerank

QDRANT_BASE_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=learning_knowledge_v1_1024
QDRANT_ALIAS=learning_knowledge_current
QDRANT_REQUIRE_SECURE_TRANSPORT=false

# Stage 7 management plane. Port 9123 must stay on a private container network.
MANAGEMENT_PORT=9123
MANAGEMENT_ADDRESS=127.0.0.1
MANAGEMENT_TRACING_ENABLED=false
MANAGEMENT_TRACING_SAMPLING=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
GRAFANA_ADMIN_PASSWORD=replace_with_grafana_admin_password

# Cleanup is dark by default. Enable, run an approved dry-run, then enable schedule.
AI_CLEANUP_ENABLED=false
AI_CLEANUP_SCHEDULE_ENABLED=false
AI_CLEANUP_POLICY_VERSION=stage7-v1
AI_CLEANUP_BATCH_SIZE=500
AI_CLEANUP_MAX_RUNTIME_SECONDS=600
AI_CLEANUP_LEASE_SECONDS=90
AI_CLEANUP_DRY_RUN_VALID_HOURS=24
AI_CLEANUP_BODY_RETENTION_DAYS=30
AI_CLEANUP_METADATA_RETENTION_DAYS=90
AI_CLEANUP_SUCCESS_EVENT_RETENTION_DAYS=14
AI_CLEANUP_ADMIN_AUDIT_RETENTION_DAYS=180
AI_DAILY_COST_SOFT_LIMIT=
AI_DAILY_COST_HARD_LIMIT=
