# Copy to .env.local and replace placeholders. Never commit real credentials.
SPRING_PROFILES_ACTIVE=dev

DB_HOST=localhost
DB_PORT=3306
DB_NAME=learning_manage
DB_USERNAME=learning_manage_app
DB_PASSWORD=replace_with_local_database_password
MYSQL_ROOT_PASSWORD=replace_with_mysql_root_password

# Flyway is disabled by default. The migrator account is separate from the
# business account and must only be supplied in a protected migration session.
FLYWAY_ENABLED=false
FLYWAY_DB_USERNAME=learning_manage_migrator
FLYWAY_DB_PASSWORD=replace_with_migrator_password
FLYWAY_EXPECTED_DB_NAME=learning_manage
FLYWAY_BASELINE_VERSION=1
FLYWAY_BASELINE_AUTHORIZED=false

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=

JWT_SECRET=replace_with_at_least_32_random_characters
JWT_EXPIRE_SECONDS=86400

ALIYUN_API_KEY=replace_with_your_api_key
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_CHAT_ENABLED=true
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=60000
AI_TOTAL_TIMEOUT_MS=120000
AI_MAX_CONCURRENT_CALLS=20
AI_MAX_WAIT_MILLIS=0
AI_PRICE_VERSION=
AI_PRICE_CURRENCY=CNY
QWEN_PLUS_INPUT_PRICE=
QWEN_PLUS_OUTPUT_PRICE=

# Model prices are deliberately not committed because supplier prices change.
# Empty prices keep estimated_cost NULL. Both values and AI_PRICE_VERSION must
# be configured together in protected deployment configuration.

AI_KNOWLEDGE_WORKER_ENABLED=false
AI_KNOWLEDGE_POLL_MS=2000
AI_KNOWLEDGE_CLAIM_BATCH_SIZE=20
AI_KNOWLEDGE_WORKER_CONCURRENCY=4
AI_KNOWLEDGE_LEASE_SECONDS=60
AI_KNOWLEDGE_MAX_ATTEMPTS=5
AI_KNOWLEDGE_EMBEDDING_CONCURRENCY=4
AI_KNOWLEDGE_VECTOR_CONCURRENCY=8
AI_KNOWLEDGE_CB_WINDOW_SIZE=20
AI_KNOWLEDGE_CB_MINIMUM_CALLS=10
AI_KNOWLEDGE_CB_FAILURE_RATE=50
AI_KNOWLEDGE_CB_OPEN_WAIT_MS=30000

AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSION=1024
AI_EMBEDDING_BATCH_SIZE=10

QDRANT_BASE_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=learning_knowledge_v1_1024
QDRANT_ALIAS=learning_knowledge_current
QDRANT_REQUIRE_SECURE_TRANSPORT=false
