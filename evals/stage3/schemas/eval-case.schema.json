{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learningmanage.local/schemas/stage3-eval-case.schema.json",
  "title": "LearningManage Stage 3 evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "caseId",
    "scene",
    "split",
    "tags",
    "actor",
    "fixtureKey",
    "requestPayload",
    "expectedInvariants",
    "semanticRubric",
    "allowedResourceIds",
    "datasetVersion",
    "labelVersion"
  ],
  "properties": {
    "caseId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{4,63}$"},
    "scene": {
      "enum": ["task-breakdown", "weekly-polish", "today-order", "daily-rename", "list-replan"]
    },
    "split": {"enum": ["development", "regression", "holdout", "failure-injection"]},
    "tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "actor": {"enum": ["owner", "member", "outsider"]},
    "fixtureKey": {"type": "string", "minLength": 1},
    "requestPayload": {"type": "object"},
    "expectedInvariants": {"type": "object"},
    "semanticRubric": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "allowedResourceIds": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "datasetVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "labelVersion": {"type": "integer", "minimum": 1}
  }
}
