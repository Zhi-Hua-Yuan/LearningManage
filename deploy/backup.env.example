# Copy to /etc/learning-manage/backup.env with mode 0640.
# The age private key is deliberately not stored on the server.
BACKUP_AGE_RECIPIENT=age1REPLACE_WITH_OFFLINE_PUBLIC_RECIPIENT
OSS_BUCKET_URI=s3://REPLACE_PRIVATE_BUCKET/learning-manage
S3CMD_CONFIG=/etc/learning-manage/s3cfg
BACKUP_DIRECTORY=/var/backups/learning-manage
