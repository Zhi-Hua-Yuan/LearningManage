# Copy to /etc/learning-manage/learning.env on the server.
# Replace every REPLACE_* value. Never commit the populated file.

# Release identity and locally assembled application images.
BACKEND_SHA=REPLACE_WITH_40_CHARACTER_BACKEND_SHA
FRONTEND_SHA=REPLACE_WITH_40_CHARACTER_FRONTEND_SHA
BACKEND_IMAGE=learningmanage-backend:REPLACE_WITH_BACKEND_SHA
FRONTEND_IMAGE=learningmanage-frontend:REPLACE_WITH_FRONTEND_SHA

# Every third-party image must be copied from the successful Release Gate
# inventory and must include @sha256:<64 lowercase hex characters>.
RUNTIME_IMAGE=eclipse-temurin:17-jre-alpine@sha256:b0ae54a36f82e04dc6c45e40ca5c55762e20b9a0858ee457faf557d440a9b571
NGINX_IMAGE=nginx:1.29.1-alpine@sha256:42a516af16b852e33b7682d5ef8acbd5d13fe08fecadc7ed98605ba5e3b26ab8
MYSQL_IMAGE=mysql:8.0.41@sha256:bf577825b52ab281d6281fb281eabbfdc73507eda8f2c2745790251533ef0306
REDIS_IMAGE=redis:7.4-alpine@sha256:ff02b58f971e7d7d156a1267e283fcbbeee91773b6aa36c49dac28ecfe28eadf
QDRANT_IMAGE=qdrant/qdrant:v1.18.2@sha256:75eab8c4ba42096724fdcfde8b4de0b5713d529dde32f285a1f86fdcb2c9e50c
PROMETHEUS_IMAGE=prom/prometheus:v2.54.1@sha256:f6639335d34a77d9d9db382b92eeb7fc00934be8eae81dbc03b31cfe90411a94
TEMPO_IMAGE=grafana/tempo:2.6.1@sha256:ef4384fce6e8ad22b95b243d8fc165628cda655376fd50e7850536ad89d71d50
GRAFANA_IMAGE=grafana/grafana:11.2.2@sha256:d5133220d770aba5cb655147b619fa8770b90f41d8489a821d33b1cd34d16f89

# Root and Grafana passwords are stored as mode-0600 files, not inline here.
MYSQL_ROOT_PASSWORD_FILE=/etc/learning-manage/secrets/mysql-root-password
GRAFANA_ADMIN_PASSWORD_FILE=/etc/learning-manage/secrets/grafana-admin-password

DB_NAME=learning_manage
DB_USERNAME=learning_manage_app
DB_PASSWORD=REPLACE_WITH_APPLICATION_DATABASE_PASSWORD
DB_CONNECTION_TIMEOUT_MS=5000
DB_VALIDATION_TIMEOUT_MS=2000

REDIS_DATABASE=0
REDIS_PASSWORD=REPLACE_WITH_REDIS_ACL_PASSWORD

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
JWT_EXPIRE_SECONDS=86400

ALIYUN_API_KEY=REPLACE_WITH_ALIYUN_API_KEY
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_MODEL=qwen-plus
AI_BREAKDOWN_MODEL=qwen-plus
AI_POLISH_MODEL=qwen-flash
AI_FALLBACK_MODEL=qwen-plus
AI_CHAT_ENABLED=true
# Spring AI is the default Phase 5 Chat transport. Set legacy only for emergency rollback.
AI_CHAT_ADAPTER=spring-ai
AI_CONNECT_TIMEOUT_MS=5000
AI_READ_TIMEOUT_MS=60000
AI_TOTAL_TIMEOUT_MS=120000
AI_MAX_CONCURRENT_CALLS=4
AI_MAX_WAIT_MILLIS=0

# Leave model prices empty until a dated supplier price sheet is approved.
AI_PRICE_VERSION=
AI_PRICE_CURRENCY=CNY
QWEN_PLUS_INPUT_PRICE=
QWEN_PLUS_OUTPUT_PRICE=
AI_DAILY_COST_SOFT_LIMIT=
AI_DAILY_COST_HARD_LIMIT=

AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_FAIL_OPEN=false

# Knowledge indexing is enabled by default and can be disabled for rollback.
AI_KNOWLEDGE_WORKER_ENABLED=true
AI_KNOWLEDGE_POLL_MS=2000
AI_KNOWLEDGE_CLAIM_BATCH_SIZE=5
AI_KNOWLEDGE_WORKER_CONCURRENCY=1
AI_KNOWLEDGE_LEASE_SECONDS=60
AI_KNOWLEDGE_MAX_ATTEMPTS=5
AI_KNOWLEDGE_EMBEDDING_CONCURRENCY=1
AI_KNOWLEDGE_VECTOR_CONCURRENCY=2

AI_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_EMBEDDING_QUERY_BASE_URL=https://dashscope.aliyuncs.com/api/v1
AI_EMBEDDING_API_KEY=REPLACE_WITH_EMBEDDING_API_KEY
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSION=1024
AI_EMBEDDING_BATCH_SIZE=10

# RAG is enabled by default and remains fail-closed until its dependencies are ready.
AI_RAG_ENABLED=true
AI_RAG_REQUIRE_BACKFILL=true
AI_RAG_QUESTION_HMAC_SECRET=REPLACE_WITH_A_SEPARATE_32_CHARACTER_RANDOM_SECRET
AI_RAG_CONFIG_VERSION=rag-v1
AI_RAG_INITIAL_TOP_K=20
AI_RAG_FINAL_TOP_K=8
AI_RAG_VECTOR_SCORE_THRESHOLD=0.25
AI_RAG_RERANK_SCORE_THRESHOLD=0.20
AI_RAG_RESULT_RETENTION_DAYS=30

AI_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
AI_RERANK_API_KEY=REPLACE_WITH_RERANK_API_KEY
AI_RERANK_MODEL=qwen3-rerank
AI_RERANK_MAX_CONCURRENT_CALLS=1

# Qdrant uses authenticated HTTP only inside data-internal. No Qdrant port is
# published to the host; therefore the application transport guard is disabled.
QDRANT_API_KEY=REPLACE_WITH_QDRANT_API_KEY
QDRANT_COLLECTION=learning_knowledge_v1_1024
QDRANT_ALIAS=learning_knowledge_current

# Agent, Agent Worker and controlled Tool Calling are enabled by default.
AI_AGENT_ENABLED=true
AI_AGENT_WORKER_ENABLED=true
AI_AGENT_TOOL_CALLING_ENABLED=true
AI_AGENT_POLL_DELAY_MS=1000
AI_AGENT_BATCH_SIZE=1
AI_AGENT_MAX_CONCURRENT_RUNS=1
AI_AGENT_MAX_CONCURRENT_RUNS_PER_USER=1
AI_AGENT_LEASE_SECONDS=90
AI_AGENT_HEARTBEAT_SECONDS=15
AI_AGENT_OVERALL_TIMEOUT_SECONDS=60
AI_AGENT_TOOL_TIMEOUT_SECONDS=10
AI_AGENT_MAX_TOOL_CALLS=4
AI_AGENT_MAX_ATTEMPTS=2

# Actuator is reachable only on Docker's observability-internal network.
MANAGEMENT_TRACING_ENABLED=false
MANAGEMENT_TRACING_SAMPLING=0.02
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318/v1/traces

# Cleanup is fully disabled by default and requires an approved dry run.
AI_CLEANUP_ENABLED=false
AI_CLEANUP_SCHEDULE_ENABLED=false
AI_CLEANUP_POLICY_VERSION=stage7-v1
AI_CLEANUP_BATCH_SIZE=100
AI_CLEANUP_MAX_RUNTIME_SECONDS=300
AI_CLEANUP_LEASE_SECONDS=90
AI_CLEANUP_DRY_RUN_VALID_HOURS=24
AI_CLEANUP_BODY_RETENTION_DAYS=30
AI_CLEANUP_METADATA_RETENTION_DAYS=90
AI_CLEANUP_SUCCESS_EVENT_RETENTION_DAYS=14
AI_CLEANUP_ADMIN_AUDIT_RETENTION_DAYS=180

JAVA_TOOL_OPTIONS=-Xms128m -Xmx512m -XX:MaxMetaspaceSize=192m
